#!/bin/bash
# Paul Save – Personalakte automatisch auf GitHub speichern

set -e

# Finde das echte Git-Repo (gehe nach oben bis .git gefunden wird)
find_repo_root() {
    local current_dir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
    while [ "$current_dir" != "/" ]; do
        if [ -d "$current_dir/.git" ]; then
            echo "$current_dir"
            return 0
        fi
        current_dir="$(dirname "$current_dir")"
    done
    echo "$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
}

REPO_DIR=$(find_repo_root)
EXAMPLES_DIR="$REPO_DIR/examples"

# Git-Config
GIT_NAME=$(git config --global user.name 2>/dev/null || echo "cygV404")
GIT_EMAIL=$(git config --global user.email 2>/dev/null || echo "v404cyg@proton.me")

echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║  💾 Paul Save – Speichern auf GitHub           ║"
echo "╚════════════════════════════════════════════════╝"
echo ""
echo "Git-User: $GIT_NAME <$GIT_EMAIL>"
echo ""

# Frage 1: Agenten-Name
read -p "📝 Agenten-Name (z.B. docker-monitor): " agent_name

if [ -z "$agent_name" ]; then
    echo "❌ Name darf nicht leer sein!"
    exit 1
fi

# Sanitize filename
filename=$(echo "$agent_name" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | sed 's/[^a-z0-9-]//g')
filepath="$EXAMPLES_DIR/$filename.md"

# Frage 2: Personalakte einfügen
echo ""
echo "📋 Personalakte eingeben (Ctrl+D zum Beenden):"
echo "   (Kopiere alles zwischen den \`\`\` Blöcken)"
echo ""

# Lese Personalakte bis EOF
personalakte=$(cat)

if [ -z "$personalakte" ]; then
    echo "❌ Personalakte ist leer!"
    exit 1
fi

# Speichere Datei (mit Escape für Backticks)
mkdir -p "$EXAMPLES_DIR"
printf '%s\n' "$personalakte" > "$filepath"
echo ""
echo "✅ Gespeichert: $filepath"

# Git-Commit
cd "$REPO_DIR"
git add "$filepath"

# Commit mit Agenten-Name
commit_msg="Neue Personalakte: $agent_name"
git commit -m "$commit_msg"

echo "✅ Committed: '$commit_msg'"

# Push to GitHub
git push
echo "✅ Auf GitHub gepusht!"

echo ""
echo "🎉 Fertig!"
echo "   Personalakte: $filepath"
echo "   Nutze die Personalakte jetzt als System-Prompt für einen neuen Assistenten!"
echo ""
