#!/bin/bash
# Paul – Personalchef für KI-Assistenten
# Einfacher Starter für Claude Code

REPO_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PAUL_PROMPT="$REPO_DIR/examples/paul.md"

# Überprüfe ob Paul existiert
if [ ! -f "$PAUL_PROMPT" ]; then
    echo "❌ Fehler: $PAUL_PROMPT nicht gefunden"
    exit 1
fi

# Git-Config aus System lesen oder Fallback
GIT_NAME=$(git config --global user.name 2>/dev/null || echo "cygV404")
GIT_EMAIL=$(git config --global user.email 2>/dev/null || echo "v404cyg@proton.me")

echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║  🎩 Paul – Personalchef für KI-Assistenten    ║"
echo "╚════════════════════════════════════════════════╝"
echo ""
echo "Arbeitsdir: $REPO_DIR"
echo "Git-User: $GIT_NAME <$GIT_EMAIL>"
echo ""
echo "$(cat "$PAUL_PROMPT")"
echo ""
echo "════════════════════════════════════════════════════════════════"
echo "Paul läuft jetzt in Claude Code!"
echo "════════════════════════════════════════════════════════════════"
echo ""
echo "💡 TIPP: Nach Pauls Output die Personalakte mit:"
echo "   ./paul-save"
echo "   (oder: paul-save)"
echo ""
echo "   Dadurch wird die Personalakte automatisch auf GitHub gespeichert!"
echo "════════════════════════════════════════════════════════════════"
