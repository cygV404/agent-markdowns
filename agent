#!/bin/bash
# Agent Launcher – Startet gespeicherte KI-Assistenten
# Nutzung: agent uwe, agent docker-monitor, etc.

set -e

# Finde das echte Git-Repo
find_repo_root() {
    # BASH_SOURCE kann ein Symlink sein (z.B. ~/.local/bin/agent -> Repo).
    # readlink -f loest ihn auf, sonst wird im Symlink-Verzeichnis gesucht.
    local self_dir
    self_dir="$( cd "$( dirname "$(readlink -f "${BASH_SOURCE[0]}")" )" && pwd )"
    local current_dir="$self_dir"
    while [ "$current_dir" != "/" ]; do
        if [ -d "$current_dir/.git" ]; then
            echo "$current_dir"
            return 0
        fi
        current_dir="$(dirname "$current_dir")"
    done
    echo "$self_dir"
}

REPO_DIR=$(find_repo_root)
EXAMPLES_DIR="$REPO_DIR/examples"

# Überprüfe Argumente
if [ $# -eq 0 ]; then
    echo "❌ Agent-Name erforderlich!"
    echo ""
    echo "Verfügbare Agenten:"
    if [ -d "$EXAMPLES_DIR" ]; then
        ls -1 "$EXAMPLES_DIR"/*.md 2>/dev/null | xargs -I {} basename {} .md | sed 's/^/  - /'
    else
        echo "  (keine Agenten gefunden)"
    fi
    echo ""
    echo "Nutzung: agent <name>"
    echo "Beispiel: agent uwe"
    exit 1
fi

AGENT_NAME="$1"
shift
MESSAGE="$*"

# Suche Personalakte
PERSONALITY_FILE="$EXAMPLES_DIR/$AGENT_NAME.md"

# Falls nicht exakt gefunden, fuzzy search
if [ ! -f "$PERSONALITY_FILE" ]; then
    FOUND=$(find "$EXAMPLES_DIR" -name "*$AGENT_NAME*.md" 2>/dev/null | head -1)
    if [ -n "$FOUND" ]; then
        PERSONALITY_FILE="$FOUND"
    else
        echo "❌ Agent nicht gefunden: $AGENT_NAME"
        echo ""
        echo "Verfügbare Agenten:"
        ls -1 "$EXAMPLES_DIR"/*.md 2>/dev/null | xargs -I {} basename {} .md | sed 's/^/  - /'
        exit 1
    fi
fi

# Personalakte wird per Datei uebergeben (nicht per argv -> nicht in `ps` sichtbar).
# --system-prompt-file ist in --help nicht dokumentiert, existiert aber. Auf CLI-
# Versionen ohne das Flag wird auf --system-prompt zurueckgefallen.
# Die Probe kostet ~1,5s, daher gecacht; der Cache-Key haengt am aufgeloesten
# claude-Pfad und invalidiert sich bei jedem CLI-Update von selbst.
CLAUDE_BIN="$(command -v claude || echo claude)"
VER_TAG="$(readlink -f "$CLAUDE_BIN" 2>/dev/null || echo "$CLAUDE_BIN")"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-launcher"
CACHE_FILE="$CACHE_DIR/spf-$(printf '%s' "$VER_TAG" | md5sum | cut -c1-16)"

if [ -r "$CACHE_FILE" ]; then
    SPF_OK="$(cat "$CACHE_FILE")"
else
    if claude --system-prompt-file /dev/null --print "" 2>&1 | grep -q "unknown option"; then
        SPF_OK=0
    else
        SPF_OK=1
    fi
    mkdir -p "$CACHE_DIR" && printf '%s' "$SPF_OK" > "$CACHE_FILE"
fi

# Abnahme des Launchers: NICHT die Antwort im Terminal pruefen. Generisches
# Claude ohne Personalakte antwortet ebenso plausibel, der Fehler bleibt
# unsichtbar. Geprueft wird die tatsaechliche Kommandozeile:
#   bash -x ./agent uwe "x" < /dev/null 2>&1 | grep '^+ exec'
# Muss --system-prompt-file zeigen, im Fallback --system-prompt.
if [ "$SPF_OK" = "1" ]; then
    SPF=(--system-prompt-file "$PERSONALITY_FILE")
else
    SPF=(--system-prompt "$(cat "$PERSONALITY_FILE")")
fi

# Arbeitsverzeichnis bestimmen.
# Ein Agent muss dort starten, wo seine Arbeit liegt - nicht dort, wo der
# Launcher liegt. Nur so findet Claude Code das CLAUDE.md des Projekts.
# Optionales Feld in der Personalakte:  WORKDIR: ~/docker
# Ohne Angabe bleibt es beim bisherigen Verhalten (Repo-Verzeichnis).
WORKDIR="$(grep -m1 '^WORKDIR:' "$PERSONALITY_FILE" 2>/dev/null | sed 's/^WORKDIR:[[:space:]]*//; s/[[:space:]]*$//')"
WORKDIR="${WORKDIR/#\~/$HOME}"

if [ -z "$WORKDIR" ]; then
    TARGET_DIR="$REPO_DIR"
elif [ -d "$WORKDIR" ]; then
    TARGET_DIR="$WORKDIR"
else
    # Nicht stillschweigend zurueckfallen - ein Agent am falschen Ort sieht
    # aus wie ein Agent, der funktioniert.
    echo "⚠️  WORKDIR '$WORKDIR' existiert hier nicht – starte stattdessen in $REPO_DIR"
    TARGET_DIR="$REPO_DIR"
fi

# Zeige Agent-Info
echo ""
echo "╔════════════════════════════════════════════════╗"
echo "║  🤖 Agent: $(basename "$PERSONALITY_FILE" .md)"
echo "║     Startet in Claude Code...                  ║"
echo "║     Arbeitsverzeichnis: $TARGET_DIR"
echo "╚════════════════════════════════════════════════╝"
echo ""

# Starte Claude mit der Personalakte
cd "$TARGET_DIR"

# In einer bereits laufenden Claude-Code-Session (verschachtelt) ist kein
# interaktiver Start möglich -> automatisch auf --print umschalten.
if [ -n "$CLAUDECODE" ] || [ -n "$CLAUDE_CODE_CHILD_SESSION" ]; then
    if [ -n "$MESSAGE" ]; then
        exec claude --print "${SPF[@]}" "$MESSAGE"
    elif [ ! -t 0 ] && read -r -t 0.1 FIRST_LINE; then
        exec claude --print "${SPF[@]}" <<EOF
$FIRST_LINE
$(cat)
EOF
    else
        echo "⚠️  Läuft verschachtelt in einer Claude-Code-Session – interaktiver Modus nicht möglich."
        echo "   Bitte eine Nachricht mitgeben: agent $AGENT_NAME <deine Nachricht>"
        exit 1
    fi
else
    # ${MESSAGE:+...} haengt die Nachricht nur an, wenn eine da ist. Ohne das
    # wird `agent uwe "..."` im normalen Terminal wortlos verschluckt.
    exec claude "${SPF[@]}" ${MESSAGE:+"$MESSAGE"}
fi
